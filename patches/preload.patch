+// On GNOME/KDE the native titlebar already supplies minimize/maximize/close.
+// On Windows, the Chromium titlebar overlay supplies these buttons. Avoid
+// showing the site's own desktop controls *as well* on either platform.
+addStyle(
+  "melty-titlebar-style",
+  `
+    .desktop-window-controls { display: none !important; }
+    ${USE_WINDOWS_TITLEBAR_OVERLAY ? ".is-desktop .topbar { padding-right: 148px !important; }" : ""}
+  `
+);
 
